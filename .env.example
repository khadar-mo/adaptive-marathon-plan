# Your personal api key. Generate @ Garmin Connect(Profile & Account → Settings → Personal API Key)
GARMIN_PERSONAL_API_KEY=GARMIN_PERSONAL_API_KEY

# STRAVA - Standard REST API - https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:8000/callback

